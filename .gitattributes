* text=auto

# Keep executable and service surfaces LF-normalized for Linux/VM use.
*.sh text eol=lf
*.bash text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.socket text eol=lf
systemd/* text eol=lf

*.py text eol=lf
*.sql text eol=lf

*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
